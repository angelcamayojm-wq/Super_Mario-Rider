# Copy this file to .env locally and replace each placeholder.
# Never commit .env or provider credentials.

PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000

# Auth mailer
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# PostgreSQL / Neon
POSTGRES_URL=

# MySQL / Aiven
MYSQL_URL=

# MongoDB Atlas
MONGO_URI=

# Firebase Admin SDK JSON path. Keep the JSON outside Git.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Turso / libSQL
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Astra DB
ASTRA_DB_CLIENT_ID=
ASTRA_DB_SECRET=
ASTRA_DB_TOKEN=
ASTRA_DB_KEYSPACE=
